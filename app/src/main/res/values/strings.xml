    <!-- Instruction steps: analyze text -->
    <string name="instruction_analyze_text_step_1">Enter some text containing food or drink items.\nFor example enter what you had for lunch: \"steak and fries.\"</string>
    <string name="instruction_analyze_text_step_2">If you want to get a more precise nutrition data, you can prefix the item with a quantity.\nExample: \"20g chocolate and 2 bananas\"\n(the default quantity is 100 grams)</string>
